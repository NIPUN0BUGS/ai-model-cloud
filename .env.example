# Copy to .env and replace EVERY value marked CHANGE_ME. Never commit .env.
# Generate secrets with:  openssl rand -hex 32
APP_ENV=production
DOMAIN=localhost                      # your domain for HTTPS, or "localhost" for local dev
POSTGRES_DB=aimodelcloud
POSTGRES_USER=aimodelcloud
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME                  # signs session/CSRF tokens
API_KEY_PEPPER=CHANGE_ME              # HMAC pepper for API key hashing
# First super admin is created on first boot if no admin exists
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
CORS_ORIGINS=https://localhost
SESSION_TTL_HOURS=168
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
MAX_PROMPT_CHARS=32000
MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=300
MAX_CONCURRENT_INFERENCE=4
# Optional SMTP (email verification / reset are disabled when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
